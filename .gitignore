# Large / generated — not committed.
# (NOTE: git .gitignore does NOT support inline comments — keep patterns on their own line.)

# cloned 7kaa engine source — its own git repo; clone separately (see MAINTAINING.md)
src/engine/
# Emscripten SDK toolchain — its own git repo; install separately
.toolchain/
# extracted game data (download separately; large)
data/
# emscripten build output (.js/.wasm/.data) and the object cache — regenerated by make build
build/
# packaged uploads (itch zip, local edition) — regenerated by make package
dist/
*.tar.gz
*.tar.xz

# Logs
logs/
*.log

# Node (relay deps — re-installed via `npm install`)
node_modules/

# OS / editor
.DS_Store
*.swp
.gstack/

# local-only release scratch (Reddit announcement draft — not for the public repo)
docs/reddit-post.md

# Python bytecode from the scripts
__pycache__/
*.pyc

# NOTE: site/ is deliberately NOT ignored. It is the deploy artifact: GitHub Pages uploads
# this folder as-is because CI has no build step, the same way a gh-pages branch is committed.
# Regenerate it with `make stage`; verify it with `make check`.
