diff --git a/src/OINFO.cpp b/src/OINFO.cpp
index 4b3e78a..fafe5c4 100644
--- a/src/OINFO.cpp
+++ b/src/OINFO.cpp
@@ -349,7 +349,7 @@ static void publish_selected_object()
 		Unit* unitPtr=unit_array[unit_array.selected_recno];
 		if( unitPtr->race_id && unit_res[unitPtr->unit_id]->unit_class == UNIT_CLASS_HUMAN )
 		{
-			const char* role = unitPtr->spy_recno ? "Spy" :
+			const char* role = unitPtr->rank_id==RANK_KING ? "King" : unitPtr->spy_recno ? "Spy" :
 				unitPtr->skill.skill_id ? unitPtr->skill.skill_des() : "Peasant";
