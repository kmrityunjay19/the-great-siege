+// Guest entry point + relay-URL/room-code parser. cmdLine is whatever the user
+// typed into the "Enter Address" box (or a launch arg): a relay URL, a room
+// code, or both joined by '#'.
+int MultiPlayer::init_lobbied(int maxPlayers, char *cmdLine)
+{
+	if (!cmdLine) {
+		// hosting-from-lobby is not supported (mirror enet)
+		lobbied_flag = 1;
+		return 1;
+	}
+
+	char url[256] = {0};
+	char code[80] = {0};
+	parse_relay_target(cmdLine, url, sizeof(url), code, sizeof(code));
+
+	resolve_relay_url(url[0] ? url : NULL);
+	sanitize_code(code, g_room_code, sizeof(g_room_code));
+	if (!g_room_code[0]) {
+		ERR("[ws] no room code in '%s'\n", cmdLine);
+		return 0;
+	}
+
+	// register the (single) joinable session; the host is always relay id 1
+	guuid_t sessionId;
+	misc.uuid_generate_random(sessionId);
+	SessionDesc session("Relay Game", sessionId, SessionFlags::Pregame, id_address(1));
+	strcpy(session.password, "1");
+	session.max_players = maxPlayers;
+	current_sessions.linkin(&session);
+
+	g_is_host = false;
+	sanitize_name(my_player.name, g_my_name, sizeof(g_my_name));
+
+	if (!ws_connect())
+		return 0;
+
+	lobbied_flag = 2;
+	return 1;
+}
