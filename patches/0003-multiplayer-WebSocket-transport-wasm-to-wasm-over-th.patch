+void MultiPlayer::delete_player(uint32_t playerId)
+{
+	if (playerId < 1 || playerId > MAX_NATION)
+		return;
+
+	g_peer_connected[playerId] = 0;
+	if (g_known[playerId]) {
+		MSG("[ws] player '%s' (%u) deleted\n", g_known[playerId]->name, playerId);
+		delete g_known[playerId];
+		g_known[playerId] = NULL;
+	}
+	update_player_pool();
+}
