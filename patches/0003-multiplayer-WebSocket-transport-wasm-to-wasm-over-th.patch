+// Filename    : mp_address.h
+// Description : The ENetAddress type used as an opaque peer key by MultiPlayer.
+//
+// With the native enet transport (USE_ENET) this is enet's own struct. For the
+// browser WebSocket transport there is no real network address, so we define a
+// fixed-layout POD instead. It must serialize byte-identically on both clients
+// because MpStructAcceptNewPlayer (OGAMEMP.cpp) embeds it by value and sends it
+// over the wire; the explicit `reserved0` pad pins sizeof at 8 with no implicit
+// padding on either build. Only `host` is meaningful for the WS transport and it
+// carries the relay-assigned player id (host==0 means "unknown/any", mirroring
+// ENET_HOST_ANY). The layout matches the existing on-wire MpMsgSessionAddr /
+// MpMsgHostNatPunch structs in multiplayer.h.
+
+#ifndef __MP_ADDRESS_H
+#define __MP_ADDRESS_H
+
+#include <stdint.h>
+
+#ifdef USE_ENET
+#include <enet/enet.h>            // ENetAddress is enet's real struct
+#else
+typedef struct ENetAddress {
+	uint32_t host;
+	uint16_t port;
+	uint16_t reserved0;
+} ENetAddress;
+#endif
+
+#endif // __MP_ADDRESS_H
