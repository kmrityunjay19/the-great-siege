+SessionDesc *MultiPlayer::get_session(ENetAddress *address)
+{
+	for (int i = 1; i <= current_sessions.size(); i++) {
+		SessionDesc *p = (SessionDesc *)current_sessions.get(i);
+		if (p && address && p->address.host == address->host)
+			return p;
+	}
+	return NULL;
+}
