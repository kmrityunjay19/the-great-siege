+
+int MultiPlayer::send(uint32_t to, void *data, uint32_t msg_size)
+{
+	err_when(msg_size > MP_RECV_MAX_BUFFER_SIZE);
+
+	if (to == my_player_id)
+		return 0;
+	if (!g_sock || !g_open)
+		return 0;
+
+	uint32_t dst = (to == BROADCAST_PID) ? 0 : to;
+
+	char frame[4 + MP_RECV_MAX_BUFFER_SIZE];
+	memcpy(frame, &dst, 4);          // little-endian on wasm
+	memcpy(frame + 4, data, msg_size);
+
+	EMSCRIPTEN_RESULT r = emscripten_websocket_send_binary(g_sock, frame, 4 + msg_size);
+	return (r == EMSCRIPTEN_RESULT_SUCCESS) ? 1 : 0;
+}
+
+char *MultiPlayer::receive(uint32_t *from, uint32_t *size, int *sysMsgCount)
+{
+	if (sysMsgCount)
+		*sysMsgCount = 0;
+	*from = 0;
+
+	if (g_evt_head == g_evt_tail)
+		return NULL;                 // empty (mirrors enet_host_service == 0)
+
+	int i = g_evt_head;
+	WsEvent ev = g_evt[i];
+	char *ret = NULL;
+
+	switch (ev.type) {
+	case WS_EVT_CONNECT:
+		*from = ev.playerId;
+		if (sysMsgCount)
+			*sysMsgCount = 1;
+		g_peer_connected[ev.playerId] = 1;
+		if (g_is_host && !g_known[ev.playerId]) {
+			// the relay-assigned id IS the engine id for this guest; create the
+			// descriptor now (unauthorized) so auth_player()/search_player() find it
+			PlayerDesc *p = new PlayerDesc("?Anonymous?", id_address(ev.playerId));
+			p->id = ev.playerId;
+			p->authorized = 0;
+			g_known[ev.playerId] = p;
+		}
+		update_player_pool();
+		break;
+
+	case WS_EVT_DISCONNECT:
+		*from = ev.playerId;
+		if (sysMsgCount)
+			*sysMsgCount = -1;
+		g_peer_connected[ev.playerId] = 0;
+		update_player_pool();
+		break;
+
+	case WS_EVT_DATA:
+		{
+			uint32_t sz = ev.size;
+			if (sz > recv_buffer_size) {
+				delete [] recv_buf;
+				recv_buf = new char[MP_RECV_MAX_BUFFER_SIZE];
+				recv_buffer_size = MP_RECV_MAX_BUFFER_SIZE;
+			}
+			memcpy(recv_buf, g_data[i], sz);
+			*size = sz;
+			*from = ev.playerId;
+			ret = recv_buf;
+		}
+		break;
+	}
+
+	g_evt_head = (g_evt_head + 1) % WS_EVT_CAP;
+	return ret;
+}
