+// Filename    : multiplayer.cpp  (src/ws)
+// Description : Multiplayer transport over Emscripten WebSockets + a Node relay.
+//
+// A drop-in replacement for src/enet/multiplayer.cpp that implements the same
+// public MultiPlayer API but moves bytes over a WebSocket to a star-topology
+// relay (relay/relay.js) instead of enet/UDP. The relay is a dumb router:
+// host = player id 1, clients = 2..MAX_NATION; it re-frames each game frame with
+// the SENDER id and synthesizes CONNECT/DISCONNECT control frames. WebSocket/TCP
+// is reliable+ordered, so the engine's ec_remote lockstep layer is untouched and
+// game_starting() is a no-op. Scope is wasm<->wasm only (FLAG_UNKNOWN_BUILD stays
+// set via an undefined HAVE_KNOWN_BUILD, so the lobby refuses native joins).
+//
+// Wire protocol (must match relay/relay.js):
+//   Control = TEXT JSON: {"op":"create"|"join","code":..,"name":..} ->
+//                        {"op":"joined","playerId":N,"host":bool},
+//                        {"op":"peer_connect"|"peer_disconnect","playerId":N},
+//                        {"op":"error","msg":..}
+//   Game    = BINARY:    [dstId:u32 LE][payload]  ->  [srcId:u32 LE][payload]
+//                        (dst 0 = broadcast to room)
+
+#include <multiplayer.h>
+#include <ALL.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <dbglog.h>
+
+#ifdef USE_WS_MP
+
+#include <emscripten/emscripten.h>
+#include <emscripten/websocket.h>
+
+DBGLOG_DEFAULT_CHANNEL(MultiPlayer);
+
+#define MP_RECV_BUFFER_SIZE     (512*3)
+#define MP_RECV_MAX_BUFFER_SIZE (512*20)
+
+static_assert(sizeof(ENetAddress) == 8,
+	"ENetAddress POD must be 8 bytes so it serializes byte-identically across wasm clients");
+
+namespace {
+
+// ---- inbound event FIFO (filled by JS callbacks, drained by receive()) ----
+// One ordered ring preserves relay arrival order across data and connect/
+// disconnect events, which is what the lockstep layer needs. Single-threaded:
+// callbacks fire on the main thread during the ASYNCIFY yield, receive() also
+// runs on the main thread, and they never interleave mid-operation, so no locks.
+
+enum WsEvtType { WS_EVT_DATA, WS_EVT_CONNECT, WS_EVT_DISCONNECT };
+
+struct WsEvent {
+	WsEvtType type;
+	uint32_t  playerId;
+	uint32_t  size;     // payload size for WS_EVT_DATA
+};
+
+const int WS_EVT_CAP = 128;        // ample for MAX_NATION=7 lockstep bursts
+WsEvent   g_evt[WS_EVT_CAP];
+char      g_data[WS_EVT_CAP][MP_RECV_MAX_BUFFER_SIZE];
+int       g_evt_head = 0, g_evt_tail = 0;   // empty when head==tail
+
+// ---- connection / room state ----
+int       g_sock = 0;              // EMSCRIPTEN_WEBSOCKET_T (0 == none)
+bool      g_open = false;
+bool      g_joined = false;
+bool      g_error = false;
+bool      g_is_host = false;
+uint32_t  g_my_id = 0;             // relay-assigned id (== engine id by design)
+char      g_relay_url[256];
+char      g_room_code[80];
+char      g_my_name[MP_FRIENDLY_NAME_LEN+1];
+
+// per-player liveness + owned descriptors, indexed by playerId (1..MAX_NATION)
+unsigned char g_peer_connected[MAX_NATION+1];
+PlayerDesc   *g_known[MAX_NATION+1];
+
+ENetAddress empty_address()
+{
+	ENetAddress a;
+	a.host = 0; a.port = 0; a.reserved0 = 0;
+	return a;
+}
+
+ENetAddress id_address(uint32_t id)
+{
+	ENetAddress a;
+	a.host = id; a.port = 0; a.reserved0 = 0;
+	return a;
+}
+
+void enqueue_event(WsEvtType type, uint32_t playerId, const void *data, uint32_t size)
+{
+	int next = (g_evt_tail + 1) % WS_EVT_CAP;
+	if (next == g_evt_head) {
+		ERR("[ws] event ring full, dropping event type=%d player=%u\n", type, playerId);
+		return;
+	}
+	int i = g_evt_tail;
+	g_evt[i].type = type;
+	g_evt[i].playerId = playerId;
+	if (type == WS_EVT_DATA) {
+		if (size > MP_RECV_MAX_BUFFER_SIZE) {
+			ERR("[ws] oversized frame %u, clamped\n", size);
+			size = MP_RECV_MAX_BUFFER_SIZE;
+		}
+		if (size && data)
+			memcpy(g_data[i], data, size);
+	}
+	g_evt[i].size = size;
+	g_evt_tail = next;
+}
+
+// hand-rolled control-frame parsing (tiny fixed vocabulary, no JSON lib)
+void handle_control_text(const char *data, int len)
+{
+	char buf[256];
+	int n = (len < (int)sizeof(buf)-1) ? len : (int)sizeof(buf)-1;
+	memcpy(buf, data, n);
+	buf[n] = 0;
+
+	char op[24] = {0};
+	const char *p = strstr(buf, "\"op\":\"");
+	if (p) {
+		p += 6;
+		int i = 0;
+		while (*p && *p != '"' && i < (int)sizeof(op)-1) op[i++] = *p++;
+		op[i] = 0;
+	}
+
+	long pid = 0;
+	const char *q = strstr(buf, "\"playerId\":");
+	if (q) pid = atol(q + 11);
+
+	if (!strcmp(op, "joined")) {
+		g_joined = true;
+		g_my_id = (uint32_t)pid;
+		MSG("[ws] joined relay as playerId=%ld\n", pid);
+	} else if (!strcmp(op, "peer_connect")) {
+		if (pid >= 1 && pid <= MAX_NATION)
+			enqueue_event(WS_EVT_CONNECT, (uint32_t)pid, NULL, 0);
+	} else if (!strcmp(op, "peer_disconnect")) {
+		if (pid >= 1 && pid <= MAX_NATION)
+			enqueue_event(WS_EVT_DISCONNECT, (uint32_t)pid, NULL, 0);
+	} else if (!strcmp(op, "error")) {
+		g_error = true;
+		ERR("[ws] relay error: %s\n", buf);
+	}
+}
+
+bool ws_on_open(int, const EmscriptenWebSocketOpenEvent *e, void *)
+{
+	g_open = true;
+	char frame[160];
+	snprintf(frame, sizeof(frame), "{\"op\":\"%s\",\"code\":\"%s\",\"name\":\"%s\"}",
+		g_is_host ? "create" : "join", g_room_code, g_my_name);
+	emscripten_websocket_send_utf8_text(e->socket, frame);
+	MSG("[ws] socket open, sent %s for room '%s'\n", g_is_host ? "create" : "join", g_room_code);
+	return true;
+}
+
+bool ws_on_message(int, const EmscriptenWebSocketMessageEvent *e, void *)
+{
+	if (e->isText) {
+		handle_control_text((const char *)e->data, (int)e->numBytes);
+	} else if (e->numBytes >= 4) {
+		uint32_t src;
+		memcpy(&src, e->data, 4);    // little-endian on wasm
+		enqueue_event(WS_EVT_DATA, src, e->data + 4, e->numBytes - 4);
+	}
+	return true;
+}
+
+bool ws_on_error(int, const EmscriptenWebSocketErrorEvent *, void *)
+{
+	g_error = true;
+	ERR("[ws] socket error\n");
+	return true;
+}
+
+bool ws_on_close(int, const EmscriptenWebSocketCloseEvent *, void *)
+{
+	g_open = false;
+	// A hard socket close yields no relay peer_disconnect frames, so synthesize a
+	// DISCONNECT for every peer still believed live, or the engine hangs on the
+	// lockstep barrier instead of converting lost nations to AI.
+	for (int id = 1; id <= MAX_NATION; id++)
+		if (g_peer_connected[id])
+			enqueue_event(WS_EVT_DISCONNECT, (uint32_t)id, NULL, 0);
+	MSG("[ws] socket closed\n");
+	return true;
+}
+
+void sanitize_code(const char *in, char *out, int outsz)
+{
+	int j = 0;
+	for (int i = 0; in && in[i] && j < outsz-1; i++) {
+		char c = in[i];
+		if (c >= 'a' && c <= 'z') c = c - 'a' + 'A';
+		if ((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9'))
+			out[j++] = c;
+	}
+	out[j] = 0;
+}
+
+void sanitize_name(const char *in, char *out, int outsz)
+{
+	int j = 0;
+	for (int i = 0; in && in[i] && j < outsz-1; i++) {
+		char c = in[i];
+		if (c == '"' || c == '\\' || (unsigned char)c < 0x20) continue;
+		out[j++] = c;
+	}
+	out[j] = 0;
+}
+
+// [ws[s]://host[:port]][#CODE]  | bare CODE  | bare ws://url
+void parse_relay_target(const char *in, char *url_out, int url_sz, char *code_out, int code_sz)
+{
+	url_out[0] = 0;
+	code_out[0] = 0;
+	if (!in) return;
+	while (*in == ' ') in++;
+
+	const char *hash = strchr(in, '#');
+	if (hash) {
+		int ulen = (int)(hash - in);
+		if (ulen > 0) {
+			if (ulen >= url_sz) ulen = url_sz-1;
+			memcpy(url_out, in, ulen);
+			url_out[ulen] = 0;
+		}
+		strncpy(code_out, hash+1, code_sz-1);
+		code_out[code_sz-1] = 0;
+	} else if (strstr(in, "://")) {
+		strncpy(url_out, in, url_sz-1);
+		url_out[url_sz-1] = 0;
+	} else {
+		strncpy(code_out, in, code_sz-1);
+		code_out[code_sz-1] = 0;
+	}
+}
+
+void resolve_relay_url(const char *parsed)
+{
+	if (parsed && parsed[0]) {
+		if (strstr(parsed, "://")) {
+			strncpy(g_relay_url, parsed, sizeof(g_relay_url)-1);
+			g_relay_url[sizeof(g_relay_url)-1] = 0;
+		} else {
+			snprintf(g_relay_url, sizeof(g_relay_url), "ws://%s", parsed);
+		}
+		return;
+	}
+	const char *env = getenv("KAA_RELAY");
+	if (env && env[0]) {
+		strncpy(g_relay_url, env, sizeof(g_relay_url)-1);
+		g_relay_url[sizeof(g_relay_url)-1] = 0;
+		return;
+	}
+	strcpy(g_relay_url, "ws://localhost:8090");
+}
+
+bool ws_connect()
+{
+	if (!emscripten_websocket_is_supported()) {
+		ERR("[ws] WebSocket unsupported by this browser\n");
+		return false;
+	}
+	EmscriptenWebSocketCreateAttributes attr;
+	emscripten_websocket_init_create_attributes(&attr);
+	attr.url = g_relay_url;
+	attr.protocols = NULL;
+	attr.createOnMainThread = true;
+
+	int sock = emscripten_websocket_new(&attr);
+	if (sock <= 0) {
+		ERR("[ws] emscripten_websocket_new('%s') failed: %d\n", g_relay_url, sock);
+		return false;
+	}
+	g_sock = sock;
+	g_open = false;
+	g_joined = false;
+	g_error = false;
+	emscripten_websocket_set_onopen_callback(sock, NULL, ws_on_open);
+	emscripten_websocket_set_onmessage_callback(sock, NULL, ws_on_message);
+	emscripten_websocket_set_onerror_callback(sock, NULL, ws_on_error);
+	emscripten_websocket_set_onclose_callback(sock, NULL, ws_on_close);
+	MSG("[ws] connecting to relay %s as %s\n", g_relay_url, g_is_host ? "host" : "guest");
+	return true;
+}
+
+int sort_players(const void *a, const void *b)
+{
+	PlayerDesc *pa = *(PlayerDesc *const *)a;
+	PlayerDesc *pb = *(PlayerDesc *const *)b;
+	uint32_t ida = pa ? pa->id : 0xffffffffu;
+	uint32_t idb = pb ? pb->id : 0xffffffffu;
+	if (ida < idb) return -1;
+	if (ida > idb) return 1;
+	return 0;
+}
+
+} // anonymous namespace
+
+
+MultiPlayer::MultiPlayer() :
+	current_sessions(sizeof(SessionDesc), 10),
+	my_player("?my_player?", empty_address())
+{
+	init_flag = 0;
+	lobbied_flag = 0;
+	supported_protocols = TCPIP;
+	my_player_id = 0;
+	joined_session.flags = 0;
+	recv_buf = NULL;
+}
+
+MultiPlayer::~MultiPlayer()
+{
+	deinit();
+}
+
+void MultiPlayer::init(ProtocolType protocol_type)
+{
+	if (init_flag)
+		return;
+
+	lobbied_flag = 0;
+	my_player_id = 0;
+	update_available = -1;
+	host = NULL;
+	packet_mode = 0;
+
+	if (!is_protocol_supported(protocol_type)) {
+		ERR("[MultiPlayer::init] unsupported protocol\n");
+		return;
+	}
+
+	for (int i = 0; i < MAX_NATION; i++) {
+		player_pool[i] = NULL;
+		pending_pool[i] = NULL;
+	}
+	for (int id = 0; id <= MAX_NATION; id++) {
+		g_known[id] = NULL;
+		g_peer_connected[id] = 0;
+	}
+
+	recv_buf = new char[MP_RECV_BUFFER_SIZE];
+	recv_buffer_size = MP_RECV_BUFFER_SIZE;
+
+	g_sock = 0;
+	g_open = false;
+	g_joined = false;
+	g_error = false;
+	g_is_host = false;
+	g_my_id = 0;
+	g_evt_head = g_evt_tail = 0;
+	g_relay_url[0] = 0;
+	g_room_code[0] = 0;
+	g_my_name[0] = 0;
+
+	init_flag = 1;
+}
+
+void MultiPlayer::deinit()
+{
+	if (!init_flag)
+		return;
+
+	init_flag = 0;
+	lobbied_flag = 0;
+
+	if (g_sock) {
+		emscripten_websocket_close(g_sock, 1000, "bye");
+		emscripten_websocket_delete(g_sock);
+		g_sock = 0;
+	}
+	g_open = false;
+	g_joined = false;
+	g_error = false;
+	g_evt_head = g_evt_tail = 0;
+
+	current_sessions.zap();
+
+	for (int id = 1; id <= MAX_NATION; id++) {
+		if (g_known[id]) {
+			delete g_known[id];
+			g_known[id] = NULL;
+		}
+		g_peer_connected[id] = 0;
+	}
+	for (int i = 0; i < MAX_NATION; i++) {
+		if (pending_pool[i]) {
+			delete pending_pool[i];
+			pending_pool[i] = NULL;
+		}
+	}
+
+	if (recv_buf) {
+		delete [] recv_buf;
+		recv_buf = NULL;
+	}
+}
