+int MultiPlayer::is_player_connecting(uint32_t playerId)
+{
+	if (playerId == my_player_id)
+		return 1;
+	if (playerId < 1 || playerId > MAX_NATION)
+		return 0;
+	return g_peer_connected[playerId] ? 1 : 0;
+}
