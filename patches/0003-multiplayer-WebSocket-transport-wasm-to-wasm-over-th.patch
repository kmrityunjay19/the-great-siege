+	return 1;
+}
+
+int MultiPlayer::close_session()
+{
+	joined_session.flags = 0;
+
+	int count = 0;
+	for (int id = 1; id <= MAX_NATION; id++)
+		if (g_peer_connected[id])
+			count++;
+
+	if (g_sock) {
+		// close fires ws_on_close, which synthesizes DISCONNECTs that the
+		// engine's mp_close_session drain loop consumes via receive().
+		emscripten_websocket_close(g_sock, 1000, "leave");
+	}
+
+	return count;
+}
