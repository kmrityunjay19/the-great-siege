+SessionDesc *MultiPlayer::get_session(guuid_t id)
+{
+	for (int i = 1; i <= current_sessions.size(); i++) {
+		SessionDesc *p = (SessionDesc *)current_sessions.get(i);
+		if (p && !misc.uuid_compare(p->session_id, id))
+			return p;
+	}
+	return NULL;
+}
