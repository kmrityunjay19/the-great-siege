+// Client side of MPMSG_ACCEPT_NEW_PLAYER: a player the host told us about.
+int MultiPlayer::add_player(uint32_t playerId, char *name, ENetAddress *address, char /*contact*/)
+{
+	if (playerId == my_player_id || playerId < 1 || playerId > MAX_NATION)
+		return 0;
+
+	PlayerDesc *player = g_known[playerId];
+	if (!player) {
+		ENetAddress a = address ? *address : id_address(playerId);
+		player = new PlayerDesc(name, a);
+		g_known[playerId] = player;
+	} else {
+		strncpy(player->name, name, MP_FRIENDLY_NAME_LEN);
+		player->name[MP_FRIENDLY_NAME_LEN] = 0;
+	}
+	player->id = playerId;
+	player->authorized = 1;
+	g_peer_connected[playerId] = 1;
+
+	update_player_pool();
+	return 1;
+}
+
+// Host side: a guest sent MPMSG_NEW_PLAYER; validate and authorize it.
+int MultiPlayer::auth_player(uint32_t playerId, char *name, char *password)
+{
+	PlayerDesc *player = g_known[playerId];
+	if (!player)
+		return 0;
+
+	if ((joined_session.flags & SessionFlags::Password) &&
+		memcmp(password, joined_session.password, MP_FRIENDLY_NAME_LEN)) {
+		MSG("[ws] player %u password incorrect\n", playerId);
+		return 0;
+	}
+
+	strncpy(player->name, name, MP_FRIENDLY_NAME_LEN+1);
+	player->name[MP_FRIENDLY_NAME_LEN] = 0;
+	player->authorized = 1;
+
+	MSG("[ws] player '%s' (%u) authorized\n", player->name, playerId);
+	update_player_pool();
+	return 1;
+}
