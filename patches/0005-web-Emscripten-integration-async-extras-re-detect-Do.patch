diff --git a/src/OSYS.cpp b/src/OSYS.cpp
index d329459..3a9a9d0 100644
--- a/src/OSYS.cpp
+++ b/src/OSYS.cpp
@@ -2874,6 +2874,58 @@ int Sys::set_one_dir(const char* checkFileName, const char* defaultDir, char* tr
 //----------- End of function Sys::set_one_dir ----------//
 
 
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+//-------- web_rescan_data_dirs ----------//
+//
+// In the web build the optional content (ENCYC/ENCYC2/SCENARIO/SCENARI2/
+// TUTORIAL/MUSIC) is streamed in a separate extras.data bundle that mounts
+// asynchronously AFTER boot. set_game_dir() runs once at startup, before that
+// bundle is present, so those dir_* strings come up empty for the session.
+// The shell calls this once the bundle has mounted to re-detect them.
+//
+extern "C" EMSCRIPTEN_KEEPALIVE void web_rescan_data_dirs()
+{
+   sys.set_game_dir();        // re-run the set_one_dir() checks now that extras are mounted
+   sys.extras_loaded = 1;
+}
+
+//-------- web_set_pointer_in_window ----------//
+//
+// Called from the shell on canvas mouseleave/mouseenter — a reliable backstop
+// for SDL's WINDOWEVENT_LEAVE/ENTER so map edge-scroll stops when the cursor
+// moves off the canvas (e.g. onto a second monitor).
+//
+extern "C" EMSCRIPTEN_KEEPALIVE void web_set_pointer_in_window(int inWindow)
+{
+   mouse.in_window = inWindow ? 1 : 0;
+   if( !inWindow )
+      mouse.end_scroll();
+}
+
+//-------- web_open_donate ----------//
+//
+// "Quit" makes no sense in the browser (nothing to exit to — it just freezes
+// the canvas), so the menus repurpose it to open the donation page instead.
+//
+void web_open_donate()
+{
+   emscripten_run_script("window.open('https://ko-fi.com/cheetah9960','_blank')");
+}
+
+//-------- web_exit_fullscreen ----------//
+//
+// "Quit" makes no sense in the browser; on the web it just drops out of
+// fullscreen (paired with the shell's fullscreen button / Esc).
+//
+void web_exit_fullscreen()
+{
+   emscripten_run_script("try{(document.exitFullscreen||document.webkitExitFullscreen||function(){}).call(document);}catch(e){}");
+}
+#endif
+
+
 //-------- Start of function locate_king_general -------------//
 //
 static void locate_king_general(int rankId)
