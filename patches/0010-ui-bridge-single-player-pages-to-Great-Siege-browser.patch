diff --git a/include/web_siege_ui.h b/include/web_siege_ui.h
new file mode 100644
index 0000000..e93df06
--- /dev/null
+++ b/include/web_siege_ui.h
@@ -0,0 +1,25 @@
+// The Great Siege web presentation bridge. Native game formats remain unchanged.
+#pragma once
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <cstdio>
+#include <string>
+extern int siege_page_choice;
+inline void siege_ui_begin(const char* kind,const char* title) {
+ siege_page_choice=-1;
+ EM_ASM({window.siegeUI.open(UTF8ToString($0),UTF8ToString($1));},kind,title);
+}
+inline void siege_ui_item(int id,const char* title,const char* description,const char* art="") {
+ EM_ASM({window.siegeUI.item($0,UTF8ToString($1),UTF8ToString($2),UTF8ToString($3));},id,title,description?description:"",art);
+}
+inline int siege_ui_wait() {
+ while(siege_page_choice<0) emscripten_sleep(16);
+ int result=siege_page_choice;
+ EM_ASM({window.siegeUI.close();});
+ return result;
+}
+inline std::string siege_read_text(const char* path) {
+ std::string text;FILE* f=fopen(path,"rb");if(!f)return text;
+ char buffer[4096];size_t n;while((n=fread(buffer,1,sizeof(buffer),f)))text.append(buffer,n);fclose(f);return text;
+}
+#endif
