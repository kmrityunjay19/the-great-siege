+static int siege_select_options() {
+ Config temporary=config;
+ if(temporary.ai_nation_count<1)temporary.ai_nation_count=MAX_NATION-1;
+ if(temporary.difficulty_level!=OPTION_CUSTOM)temporary.change_difficulty(temporary.difficulty_level);
+ siege_config_ptr=&temporary;siege_map_seed=0;
+ siege_ui_begin("newgame","New game");siege_publish_options();
+ const int result=siege_ui_wait();siege_config_ptr=nullptr;
+ if(result==1) {
+  info.init_random_seed(siege_map_seed);
+  temporary.difficulty_rating=temporary.single_player_difficulty();config=temporary;
+ }
+ if(!vga_front.buf_locked)vga_front.lock_buf();
+ return result==1;
+}
