+extern "C" EMSCRIPTEN_KEEPALIVE void web_building_choice(int action, int value)
+{
+	if( !firm_array.selected_recno )
+		return;
+	Firm* firmPtr=firm_array[firm_array.selected_recno];
+	if( !firmPtr->own_firm() || firmPtr->under_construction )
+		return;
+	if( action==1 && firmPtr->firm_id==FIRM_RESEARCH &&
+		 value>=1 && value<=tech_res.tech_count && tech_res[value]->can_research(firmPtr->nation_recno) )
+		((FirmResearch*)firmPtr)->start_research(value,COMMAND_PLAYER);
+	else if( action==2 && firmPtr->firm_id==FIRM_FACTORY && value>=1 && value<=MAX_PRODUCT )
+	{
+		FirmFactory* factoryPtr=(FirmFactory*)firmPtr;
+		factoryPtr->set_product(value);
+		factoryPtr->stock_qty=0;
+		factoryPtr->raw_stock_qty=0;
+	}
+	else if( action==3 && firmPtr->firm_id==FIRM_WAR_FACTORY && value>=1 && value<=MAX_UNIT_TYPE &&
+		 unit_res[value]->unit_class==UNIT_CLASS_WEAPON &&
+		 unit_res[value]->get_nation_tech_level(firmPtr->nation_recno)>0 )
+		((FirmWar*)firmPtr)->add_queue(value,1);
+	else if( action==4 && firmPtr->firm_id==FIRM_HARBOR && value>=1 && value<=MAX_UNIT_TYPE &&
+		 unit_res[value]->unit_class==UNIT_CLASS_SHIP &&
+		 unit_res[value]->get_nation_tech_level(firmPtr->nation_recno)>0 )
+		((FirmHarbor*)firmPtr)->add_queue(value,1);
+	info.disp();
+}
