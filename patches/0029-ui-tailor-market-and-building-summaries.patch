+extern "C" EMSCRIPTEN_KEEPALIVE int web_market_can_hire()
+{
+	if( !firm_array.selected_recno )
+		return 0;
+	Firm* firmPtr=firm_array[firm_array.selected_recno];
+	return firmPtr->own_firm() && firmPtr->firm_id==FIRM_MARKET &&
+		((FirmMarket*)firmPtr)->can_hire_caravan()>0;
+}
+
+extern "C" EMSCRIPTEN_KEEPALIVE int web_market_hire()
+{
+	if( !web_market_can_hire() )
+		return 0;
+	int unitRecno=((FirmMarket*)firm_array[firm_array.selected_recno])->hire_caravan(COMMAND_PLAYER);
+	info.disp();
+	return unitRecno!=0;
+}
