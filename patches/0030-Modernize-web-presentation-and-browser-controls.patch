diff --git a/include/web_siege_present.h b/include/web_siege_present.h
new file mode 100644
index 0000000..f212ccb
--- /dev/null
+++ b/include/web_siege_present.h
@@ -0,0 +1,21 @@
+#pragma once
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+#include <string>
+inline void siege_present_begin(const char* kind,int mode=0,int reset=1) {
+ EM_ASM({if(window.siegePresentation)window.siegePresentation.begin(UTF8ToString($0),$1,$2);},kind,mode,reset);
+}
+inline void siege_present_end() { EM_ASM({if(window.siegePresentation)window.siegePresentation.end();}); }
+inline void siege_present_text(int x,int y,int h,const char* text) {
+ if(!text || !*text)return;
+ EM_ASM({if(window.siegePresentation)window.siegePresentation.text($0,$1,$2,UTF8ToString($3));},x,y,h,text);
+}
+inline void siege_present_button(int x1,int y1,int x2,int y2,const char* text,int enabled,int pushed) {
+ EM_ASM({if(window.siegePresentation)window.siegePresentation.button($0,$1,$2,$3,UTF8ToString($4),$5,$6);},x1,y1,x2,y2,text?text:"Action",enabled,pushed);
+}
+#else
+inline void siege_present_begin(const char*,int=0,int=1){}
+inline void siege_present_end(){}
+inline void siege_present_text(int,int,int,const char*){}
+inline void siege_present_button(int,int,int,int,const char*,int,int){}
+#endif
