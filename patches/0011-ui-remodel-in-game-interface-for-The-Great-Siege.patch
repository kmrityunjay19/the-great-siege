 DBGLOG_DEFAULT_CHANNEL(Vga);
 
@@ -822,6 +830,41 @@ void Vga::flip()
    if (cur_ticks > ticks + 17 || cur_ticks < ticks) {
       ticks = cur_ticks;
       SDL_BlitSurface(vga_front.surface, NULL, target, NULL);
+#ifdef __EMSCRIPTEN__
+      // Presentation only: recolor the interface in the final display copy.
+      // The indexed game buffer, terrain, minimap and serialized state stay intact.
+      if(game.init_flag && game.game_mode!=GAME_PREGAME && game.game_mode!=GAME_ENCYCLOPEDIA && target->format->BytesPerPixel==4) {
+         SDL_Color* palette=vga_front.surface->format->palette->colors;
+         Uint32 themed[256];
+         for(int c=0;c<256;c++) {
+            int r=palette[c].r,g=palette[c].g,b=palette[c].b;
+            int hi=std::max(r,std::max(g,b)),lo=std::min(r,std::min(g,b));
+            int l=(r*30+g*59+b*11)/100;
+            if(hi-lo<65) {
+               if(l<70) { r=226-l/3;g=216-l/3;b=188-l/3; }
+               else if(l<120) { r=107-(l-70)/2;g=110-(l-70)/2;b=91-(l-70)/2; }
+               else { r=19+(255-l)/9;g=31+(255-l)/9;b=34+(255-l)/9; }
+            }
+            // Flat interface surfaces and restrained gold rules replace the old bevels.
+            if(c>=0x90 && c<=0x9f) { r=28;g=43;b=45; }
+            if(c==0x9a || c==0x9e) { r=47;g=64;b=59; }
+            if(c==0x97 || c==0x98 || c==0x99) {r=76;g=91;b=82;}
+            themed[c]=SDL_MapRGB(target->format,r,g,b);
+         }
+         const bool report=sys.view_mode!=MODE_NORMAL;
+         const bool dialog=Box::opened_flag;
+         for(int y=0;y<VGA_HEIGHT;y++) {
+            Uint32* row=(Uint32*)((Uint8*)target->pixels+y*target->pitch);
+            Uint8* original=(Uint8*)vga_front.surface->pixels+y*vga_front.surface->pitch;
+            for(int x=0;x<VGA_WIDTH;x++) {
+               bool map=x>=588 && x<788 && y>=56 && y<256;
+               bool chrome=y<56 || x>=576;
+               bool modal=dialog && x>=box.box_x1 && x<=box.box_x2 && y>=box.box_y1 && y<=box.box_y2;
+               if(!map && (chrome || report || modal))row[x]=themed[original[x]];
+            }
+         }
+      }
+#endif
       SDL_UpdateTexture(texture, NULL, target->pixels, target->pitch);
       SDL_RenderClear(renderer);
       SDL_RenderCopy(renderer, texture, NULL, NULL);
