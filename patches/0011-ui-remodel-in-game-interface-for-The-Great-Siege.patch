+ EM_ASM({window.siegeUI.option("show_all_unit_icon",$0);},siege_settings_ptr->show_all_unit_icon);
+ EM_ASM({window.siegeUI.option("show_unit_path",$0);},siege_settings_ptr->show_unit_path);
+ EM_ASM({window.siegeUI.option("disp_town_name",$0);},siege_settings_ptr->disp_town_name);
+ EM_ASM({window.siegeUI.option("disp_spy_sign",$0);},siege_settings_ptr->disp_spy_sign);
+}
