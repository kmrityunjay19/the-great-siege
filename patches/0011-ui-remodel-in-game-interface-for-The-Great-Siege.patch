+extern "C" EMSCRIPTEN_KEEPALIVE void web_setting(const char* name,int value) {
+ if(!siege_settings_ptr)return;
+ if(!strcmp(name,"sound_effect_volume") && value>=0 && value<=100)siege_settings_ptr->sound_effect_volume=value;
+ if(!strcmp(name,"frame_speed") && value>=0 && value<=99)siege_settings_ptr->frame_speed=value;
+ if(!strcmp(name,"scroll_speed") && value>=1 && value<=10)siege_settings_ptr->scroll_speed=value;
+ if(!strcmp(name,"help_mode") && value>=0 && value<=2)siege_settings_ptr->help_mode=value;
+ if(!strcmp(name,"disp_news_flag") && value>=0 && value<=1)siege_settings_ptr->disp_news_flag=value;
+ if(!strcmp(name,"show_all_unit_icon") && value>=0 && value<=1)siege_settings_ptr->show_all_unit_icon=value;
+ if(!strcmp(name,"show_unit_path") && value>=0 && value<=3)siege_settings_ptr->show_unit_path=value;
+ if(!strcmp(name,"disp_town_name") && value>=0 && value<=1)siege_settings_ptr->disp_town_name=value;
+ if(!strcmp(name,"disp_spy_sign") && value>=0 && value<=1)siege_settings_ptr->disp_spy_sign=value;
