diff --git a/src/OVGA.cpp b/src/OVGA.cpp
index d6847cf..961a891 100644
--- a/src/OVGA.cpp
+++ b/src/OVGA.cpp
@@ -30,6 +30,14 @@
 #include <version.h>
 #include <FilePath.h>
 #include <ConfigAdv.h>
+#ifdef __EMSCRIPTEN__
+#include <algorithm>
+#include <OGAME.h>
+#include <OINFO.h>
