+   for(int i=0;i<GAME_OPTION_COUNT;i++)if(game_menu_option_flag[i])siege_ui_item(i+1,labels[i],descriptions[i]);
    siege_pause_action=siege_ui_wait();
    if(!siege_pause_action)siege_pause_action=8;
